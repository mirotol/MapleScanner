// The website, maplescanner.app: plain files from site/dist, with no Worker code of its own.
//   npm run site:dev       build, then serve on http://127.0.0.1:8790 (prices from the local Worker)
//   npm run site:deploy    build, then deploy. Needs `npx wrangler login`, like cloud:deploy
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "maplescanner-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // /prices serves prices.html, and an unknown address gets 404.html
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Only on the app's own domain, like the price server: the account's workers.dev address is
  // named after its email.
  "routes": [{ "pattern": "maplescanner.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
