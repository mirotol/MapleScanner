<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": signs the installer, which holds the signed app.
     The release workflow uploads the installer alone, zipped by GitHub. Paste this into the
     SignPath project's artifact configuration with the slug "installer". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="MapleScanner-Setup-${version}.exe" product-name="MapleScanner" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
