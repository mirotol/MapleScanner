{
  "name": "maple-scanner",
  "productName": "MapleScanner",
  "version": "0.2.2",
  "description": "Live prices for MapleStory Classic shops, read from your game window",
  "license": "GPL-3.0-or-later",
  "author": "mirotol",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node serve.js",
    "test": "node --test test/pricing.test.js test/market.test.js test/scanner.test.js test/cloud.test.js test/cloud-client.test.js",
    "items": "node tools/update-items.js",
    "dist": "electron-builder --win nsis --publish never",
    "cloud:dev": "wrangler dev --config cloud/wrangler.jsonc --port 8787",
    "cloud:deploy": "wrangler deploy --config cloud/wrangler.jsonc"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "electron-updater": "^6.8.11",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "wrangler": "^4.160.0"
  },
  "build": {
    "appId": "io.github.mirotol.maplescanner",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "index.html",
      "prices.html",
      "*.css",
      "fonts/**",
      "*.js",
      "osms-items.json",
      "package.json",
      "LICENSE",
      "!node_modules/@tesseract.js-data/eng/4.0.0/**",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "MapleScanner-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "mirotol",
      "repo": "MapleScanner",
      "releaseType": "draft"
    }
  }
}
