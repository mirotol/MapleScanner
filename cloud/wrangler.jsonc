// The shared price database: a Worker in front of D1.
//   npm run cloud:dev      local Worker and local D1 on http://127.0.0.1:8787, no account needed
//   npm run cloud:deploy   needs `npx wrangler login` to the account that owns maplescanner.app
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "maplescanner-api",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  // Only on the app's own domain: the account's workers.dev address is named after its email.
  "routes": [{ "pattern": "api.maplescanner.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maplescanner",
      // Created Nov 10 with `wrangler d1 create maplescanner --location weur`
      "database_id": "00a3aefa-dda1-49c1-a5bc-b7438da0e2df",
      "migrations_dir": "migrations"
    }
  ],
  // Uploads per install key and per IP address. The address is only counted, never stored.
  "ratelimits": [
    { "name": "KEY_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "IP_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": true }
  // ADMIN_TOKEN is a secret: `npx wrangler secret put ADMIN_TOKEN --config cloud/wrangler.jsonc`.
  // For the local Worker it comes from cloud/.dev.vars, which git ignores.
}
